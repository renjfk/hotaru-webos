+// SPDX-License-Identifier: LicenseRef-AGPL-3.0-only-OpenSSL
+
+// HOTARU PROBE: throwaway hooks for the multi-controller experiment (out/probe/rpd.c).
+// Not for upstream; inert unless called.
+
+#ifndef CHIAKI_PROBE_H
+#define CHIAKI_PROBE_H
+
+#include "common.h"
+#include "feedback.h"
+#include "session.h"
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define CHIAKI_PROBE_STATES_MAX 4
+
+typedef struct chiaki_probe_feedback_t
+{
+	int count; // states per feedback state packet, 1..CHIAKI_PROBE_STATES_MAX
+	int count_byte; // header byte 3 as sent; -1: count - 1
+	ChiakiFeedbackState extra[CHIAKI_PROBE_STATES_MAX]; // slots 1.. (slot 0 is the session's pad)
+	bool raw[CHIAKI_PROBE_STATES_MAX]; // send raw_bytes for this slot verbatim (slot 0 included)
+	uint8_t raw_bytes[CHIAKI_PROBE_STATES_MAX][CHIAKI_FEEDBACK_STATE_BUF_SIZE_MAX];
+} ChiakiProbeFeedback;
+
+// applies to every following feedback state packet; the next one is hexdumped to the log
+CHIAKI_EXPORT void chiaki_probe_set_feedback(const ChiakiProbeFeedback *feedback);
+
+// a ControllerConnection message; type < 0: the session's default (DualShock 4 or DualSense)
+CHIAKI_EXPORT ChiakiErrorCode chiaki_probe_send_controller_connection(ChiakiSession *session,
+		bool has_controller_id, int32_t controller_id, bool connected, int type);
+
+// one raw feedback history event (up to CHIAKI_HISTORY_EVENT_SIZE_MAX bytes) through the session's
+// feedback sender, numbered like the pad's own events
+CHIAKI_EXPORT ChiakiErrorCode chiaki_probe_push_history_event(ChiakiSession *session, const uint8_t *buf, size_t len);
+
+// session setup knobs, read when a session connects
+typedef struct chiaki_probe_setup_t
+{
+	int controller_type; // RP-ControllerType; < 0: 3
+	int client_type; // RP-ClientType; < 0: 11
+	int con_path; // RP-ConPath; < 0: 1
+	int pad_proc_no; // RP-PadProcNo; -1: 3 on a PS5 (none on a PS4), -2: not sent
+	char ctrl_extra[256]; // more ctrl request header lines, each ending in \r\n
+	char init_extra[256]; // more session request header lines, each ending in \r\n
+	char controllers[128]; // launch spec connectedControllers entries; "": "xinput","ds3","ds4"
+	char game_spec_extra[256]; // more requestGameSpecification members, each starting with a comma
+	unsigned start_cc_mask; // bit i: also announce controller id i in the stream's opening ControllerConnection
+	int start_cc_type; // their type; < 0: the session's default
+	bool start_cc_with_id0; // the session's own announcement carries controller id 0 instead of none
+} ChiakiProbeSetup;
+
+CHIAKI_EXPORT void chiaki_probe_setup_default(ChiakiProbeSetup *setup);
+CHIAKI_EXPORT void chiaki_probe_set_setup(const ChiakiProbeSetup *setup);
+CHIAKI_EXPORT void chiaki_probe_get_setup(ChiakiProbeSetup *setup);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif // CHIAKI_PROBE_H
