+// HOTARU PROBE: see chiaki/probe.h
+CHIAKI_EXPORT ChiakiErrorCode chiaki_probe_push_history_event(ChiakiSession *session, const uint8_t *buf, size_t len)
+{
+	if(!len || len > CHIAKI_HISTORY_EVENT_SIZE_MAX)
+		return CHIAKI_ERR_INVALID_DATA;
+	ChiakiStreamConnection *stream_connection = &session->stream_connection;
+	ChiakiErrorCode err = chiaki_mutex_lock(&stream_connection->feedback_sender_mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+	if(!stream_connection->feedback_sender_active)
+	{
+		chiaki_mutex_unlock(&stream_connection->feedback_sender_mutex);
+		return CHIAKI_ERR_UNINITIALIZED;
+	}
+	ChiakiFeedbackSender *feedback_sender = &stream_connection->feedback_sender;
+	err = chiaki_mutex_lock(&feedback_sender->state_mutex);
+	if(err == CHIAKI_ERR_SUCCESS)
+	{
+		ChiakiFeedbackHistoryEvent event;
+		memcpy(event.buf, buf, len);
+		event.len = len;
+		chiaki_feedback_history_buffer_push(&feedback_sender->history_buf, &event);
+		feedback_sender_history_event_pushed(feedback_sender);
+		feedback_sender->controller_state_changed = true;
+		chiaki_mutex_unlock(&feedback_sender->state_mutex);
+		chiaki_cond_signal(&feedback_sender->state_cond);
+		CHIAKI_LOGI(feedback_sender->log, "Probe history event pushed (%zu bytes)", len);
+	}
+	chiaki_mutex_unlock(&stream_connection->feedback_sender_mutex);
+	return err;
+}
